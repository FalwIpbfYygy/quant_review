# =============================================================
# quant_review 环境变量模板
# 复制本文件为 .env 并填入你自己的值（.env 已被 .gitignore 忽略，绝不会上传）。
# 下面所有值均为占位符，留空则使用代码内的公共默认值（端点 URL / 模型名等）。
# 密钥类字段留空时，依赖该密钥的功能（AI 报告、金十、TwelveData、飞书推送）将不可用或降级。
# =============================================================

# ---------- 阿里云百炼（大模型复盘 / AI 行情观点） ----------
# 兼容 DASHSCOPE_API_KEY 别名
BAILIAN_API_KEY=
# 私有业务空间 ID（用于拼兼容 OpenAI 接口的网关；留空则使用公共 DashScope 网关）
BAILIAN_WORKSPACE_ID=
# 显式网关地址（优先级高于 BAILIAN_WORKSPACE_ID 自动拼接）
BAILIAN_BASE_URL=
# 模型名
BAILIAN_MODEL=qwen3-max

# ---------- 金十 MCP（消息面 / 财经日历） ----------
JIN10_TOKEN=
JIN10_URL=
JIN10_PROTOCOL=

# ---------- Twelve Data（美元指数 DXY 合成 / 狩猎区现货日线） ----------
# xau_macro 链路
TWELVEDATA_API_KEY=
# huntzone / huntv2 链路
TWELVE_KEY=
TWELVE_BASE=
TWELVE_API=/time_series

# ---------- 飞书机器人（复盘 / 每月脉冲推送） ----------
# huntzone 复盘推送
FEISHU_WEBHOOK=
# 每月脉冲推送
FEISHU_MC_WEBHOOK=

# ---------- 数据库（仅 data_sync / DataBase 入库脚本用） ----------
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=

# ---------- 价格数据源端点（可自定义，如自建代理网关） ----------
# 价格行情接口基址（必填）：请填你自己的端点，例如自建代理或你信任的交易所 API
# 本项目不内置任何中心化交易所地址，由使用者自行决定数据源
BINANCE_FAPI_BASE=
BINANCE_SPOT_BASE=

# ---------- 代理（默认直连；本地 Windows 出网需代理时填写） ----------
# 单一代理地址同时作用于 http/https；或改用标准 HTTP_PROXY / HTTPS_PROXY
# KLINE_PROXY=
# HTTPS_PROXY=
# HTTP_PROXY=
